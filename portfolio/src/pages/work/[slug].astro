---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import ShotFrame from '../../components/ShotFrame.astro';
import { projects, creditOf, type Project } from '../../data/projects';
import { shotsFor } from '../../data/shots';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: p,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}
interface Props { project: Project; prev: Project; next: Project }
const { project: p, prev, next } = Astro.props;

const shots = shotsFor(p.slug);
const heroShot = shots.find((s) => !s.phone);
const heroPhone = shots.find((s) => s.phone);
const gallery = shots.filter((s) => s !== heroShot && s !== heroPhone);
const address = p.links[0] ? new URL(p.links[0].href).host + new URL(p.links[0].href).pathname.replace(/\/$/, '') : `${p.title} · app`;
const live = p.links[0];
const isLive = /live|delivered|production|public/i.test(p.status);

const glance = [
  ['Built for', p.client],
  ['Type', p.category],
  ['Year', p.year],
  ['Status', p.status],
  ['Built by', creditOf(p)],
].filter(([, v]) => v);
---
<Base title={p.title} description={p.summary}>
  <article class="case" style={`--a1:${p.accent[0]};--a2:${p.accent[1]}`}>
    <div class="glow" aria-hidden="true"></div>

    <!-- ───────── Hero ───────── -->
    <header class="wrap hero">
      <div class="intro">
        <a href="/#work" class="back" data-magnetic>← All work</a>
        <div class="meta reveal">
          {p.flagship && <span class="chip flag">★ Flagship</span>}
          <span class="chip">{p.category}</span>
          <span class="chip status"><span class="dot-live"></span>{p.status}</span>
        </div>
        <h1 transition:name={`title-${p.slug}`}>{p.title}</h1>
        <p class="summary reveal" style="--d:.1s">{p.summary}</p>
        {p.motto && <p class="motto reveal" style="--d:.15s">{p.motto}</p>}
        <div class="links reveal" style="--d:.2s">
          {p.links.map((l, i) => (
            <a href={l.href} target="_blank" rel="noopener" class:list={['btn', i === 0 ? 'btn-primary' : 'btn-ghost']} data-magnetic>
              {l.label} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
          {shots.length > 0 && <a href="#inside" class:list={['btn', live ? 'btn-ghost' : 'btn-primary']} data-magnetic>See the screens ({shots.length})</a>}
          {!live && shots.length === 0 && <a href="/#contact" class="btn btn-primary" data-magnetic>Ask for a demo</a>}
        </div>
      </div>

      <aside class="glance glass reveal" style="--d:.15s" aria-label="At a glance">
        <span class="eyebrow">At a glance</span>
        <dl>
          {glance.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        {p.stack.length > 0 && <ul class="mini-stack">{p.stack.slice(0, 6).map((s) => <li>{s}</li>)}</ul>}
      </aside>
    </header>

    <!-- ───────── Showcase ───────── -->
    <section class="wrap showcase" aria-label="Screens">
      {heroShot ? (
        <div class:list={['stage', { 'has-phone': !!heroPhone }]} data-stage>
          <div class="main-shot"><ShotFrame shot={heroShot} address={address} eager sizes="(max-width: 900px) 100vw, 1200px" /></div>
          {heroPhone && <div class="phone-shot"><ShotFrame shot={heroPhone} sizes="(max-width: 900px) 40vw, 300px" /></div>}
        </div>
      ) : heroPhone ? (
        <div class="stage solo-phone"><div class="phone-shot"><ShotFrame shot={heroPhone} eager sizes="320px" /></div></div>
      ) : (
        <div class="reveal"><Cover kind={p.cover} accent={p.accent} label={p.title} tag={p.category} large /></div>
      )}
    </section>

    {p.metrics.length > 0 && (
      <section class="wrap metrics" aria-label="Key numbers">
        {p.metrics.map((m, i) => (
          <div class="metric reveal" style={`--d:${i * 0.08}s`}><b>{m.value}</b><span>{m.label}</span></div>
        ))}
      </section>
    )}

    {p.problem && (
      <section class="wrap block challenge">
        <span class="eyebrow reveal" data-scramble>The challenge</span>
        <blockquote class="lead reveal"><span class="q" aria-hidden="true">“</span>{p.problem}</blockquote>
      </section>
    )}

    {p.pending && (
      <section class="wrap block">
        <div class="soon glass reveal">
          <span class="eyebrow">Walkthrough on request</span>
          <p>We are still writing up the full story behind {p.title}. Want to see it? We are happy to give you a live walkthrough.</p>
          <a href="/#contact" class="btn btn-ghost" data-magnetic>Ask for a walkthrough</a>
        </div>
      </section>
    )}

    {p.highlights.length > 0 && (
      <section class="wrap block">
        <div class="block-head">
          <span class="eyebrow reveal" data-scramble>What we built</span>
          {isLive
            ? <h2 class="reveal">Every feature here is <span class="grad">live in the product.</span></h2>
            : <h2 class="reveal">What is built, <span class="grad">and what comes next.</span></h2>}
        </div>
        <ol class="features">
          {p.highlights.map((h, i) => (
            <li class="glass reveal" style={`--d:${(i % 3) * 0.07}s`} data-spot>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <p>{h}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {gallery.length > 0 && (
      <section class="wrap block" id="inside">
        <div class="block-head">
          <span class="eyebrow reveal" data-scramble>Inside the product</span>
          <h2 class="reveal">Real screens, <span class="grad">straight from the product.</span></h2>
          <p class="note reveal">{p.screensNote ? `${p.screensNote} ` : ''}Click any screen to see it full size.</p>
        </div>
        <div class="gallery">
          {gallery.map((s, i) => (
            <div class:list={['g-item', 'reveal', { tall: s.phone }]} style={`--d:${(i % 3) * 0.07}s`}>
              <ShotFrame shot={s} address={address} showCaption sizes={s.phone ? '(max-width: 700px) 50vw, 300px' : '(max-width: 900px) 100vw, 800px'} />
            </div>
          ))}
        </div>
      </section>
    )}
    {gallery.length === 0 && shots.length > 0 && <span id="inside"></span>}

    {p.stack.length > 0 && (
      <section class="wrap block">
        <span class="eyebrow reveal" data-scramble>Built with</span>
        <ul class="stack">{p.stack.map((s, i) => <li class="reveal" style={`--d:${i * 0.04}s`}>{s}</li>)}</ul>
      </section>
    )}

    <!-- ───────── Call to action ───────── -->
    <section class="wrap block">
      <div class="cta reveal">
        <div class="cta-text">
          <span class="eyebrow">Built by {creditOf(p)}</span>
          <h2>Want something like <span class="grad">{p.title}</span>?</h2>
          <p>Tell us what you need. We design, build, launch and support it, and you talk directly to the people writing the code.</p>
        </div>
        <div class="cta-actions">
          <a href="/#contact" class="btn btn-primary" data-magnetic>Start a project</a>
          <a href="/#index" class="btn btn-ghost" data-magnetic>See all {projects.length} projects</a>
        </div>
      </div>
    </section>

    <!-- ───────── Previous / next ───────── -->
    <nav class="wrap pn" aria-label="More projects">
      {[['Previous', prev], ['Next', next]].map(([label, q]) => {
        const proj = q as Project;
        const qs = shotsFor(proj.slug).find((s) => !s.phone);
        return (
          <a href={`/work/${proj.slug}`} class="pn-card" style={`--a1:${proj.accent[0]};--a2:${proj.accent[1]}`} data-hover>
            <div class="pn-media">
              {qs ? <ShotFrame shot={qs} interactive={false} sizes="(max-width: 760px) 100vw, 560px" /> : <Cover kind={proj.cover} accent={proj.accent} label={proj.title} />}
            </div>
            <span class="eyebrow">{label} project</span>
            <span class="pn-title">{proj.title} <span aria-hidden="true">{label === 'Next' ? '→' : '←'}</span></span>
            <span class="pn-cat">{proj.category}</span>
          </a>
        );
      })}
    </nav>
  </article>

  <!-- Lightbox, filled by scripts/main.ts -->
  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Screenshot">
    <button class="lb-close" data-lb-close aria-label="Close">✕</button>
    <button class="lb-nav prev" data-lb-prev aria-label="Previous screenshot">‹</button>
    <figure><img data-lb-img alt="" /><figcaption data-lb-cap></figcaption></figure>
    <button class="lb-nav next" data-lb-next aria-label="Next screenshot">›</button>
  </div>
</Base>

<style>
  .case { position: relative; padding-top: 120px; overflow-x: clip; }
  .glow { position: absolute; inset: -10% -10% auto; height: 900px; pointer-events: none; z-index: -1;
    background: radial-gradient(50% 50% at 75% 20%, color-mix(in srgb, var(--a1) 22%, transparent), transparent 70%),
                radial-gradient(40% 40% at 10% 40%, color-mix(in srgb, var(--a2) 14%, transparent), transparent 70%);
    filter: blur(20px); }

  /* Hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.9fr); gap: clamp(28px, 4vw, 64px); align-items: end; }
  .intro { display: grid; gap: 22px; }
  .back { --mx: 0px; --my: 0px; justify-self: start; transform: translate(var(--mx), var(--my)); font-size: 14px; color: var(--text-2); padding: 8px 14px; border: 1px solid var(--line); border-radius: 99px; transition: color 0.2s, background 0.2s, transform 0.35s var(--ease); }
  .back:hover { color: var(--text); background: var(--surface-2); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip.flag { color: var(--amber); border-color: rgb(251 191 36 / 0.35); }
  .chip.status { color: #34d399; border-color: rgb(52 211 153 / 0.3); }
  h1 { font-size: clamp(50px, 8.4vw, 128px); letter-spacing: -0.055em; line-height: 0.92; background: linear-gradient(100deg, var(--text) 35%, var(--a1) 75%, var(--a2)); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: 0.06em; text-wrap: balance; }
  .summary { font-size: clamp(18px, 1.9vw, 23px); color: var(--text-2); max-width: 760px; text-wrap: pretty; }
  .motto { font-family: var(--font-mono); font-size: 14px; color: var(--a1); }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  .glance { padding: 24px; display: grid; gap: 16px; }
  .glance dl { margin: 0; display: grid; gap: 0; }
  .glance dl div { display: grid; grid-template-columns: 92px 1fr; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .glance dl div:last-child { border-bottom: 0; }
  dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); padding-top: 2px; }
  dd { margin: 0; font-size: 14.5px; }
  .mini-stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .mini-stack li { font-size: 12px; padding: 4px 10px; border-radius: 99px; background: var(--surface-2); color: var(--text-2); }

  /* Showcase: browser shot with an overlapping phone */
  .showcase { margin-top: clamp(48px, 7vw, 90px); perspective: 1600px; }
  .stage { position: relative; }
  .stage.has-phone { padding-right: clamp(40px, 9vw, 150px); padding-bottom: clamp(30px, 5vw, 60px); }
  .main-shot { transform: rotateX(10deg) scale(0.96); transform-origin: 50% 0; opacity: 0; transition: transform 1.3s var(--ease), opacity 1s var(--ease); }
  .phone-shot { position: absolute; right: 0; bottom: 0; width: clamp(130px, 21vw, 290px); transform: translateY(60px) rotate(4deg); opacity: 0; transition: transform 1.3s var(--ease) 0.25s, opacity 1s var(--ease) 0.25s; filter: drop-shadow(0 40px 60px rgb(0 0 0 / 0.5)); }
  .stage.in .main-shot { transform: none; opacity: 1; }
  .stage.in .phone-shot { transform: rotate(3deg); opacity: 1; }
  .solo-phone { display: grid; place-items: center; }
  .solo-phone .phone-shot { position: relative; width: min(320px, 70vw); }

  /* Numbers */
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 20px; margin-top: clamp(60px, 8vw, 100px); }
  .metric { border-top: 1px solid var(--line-2); padding-top: 20px; display: grid; gap: 4px; }
  .metric b { font-family: var(--font-display); font-weight: 600; font-size: clamp(42px, 5.4vw, 70px); letter-spacing: -0.05em; line-height: 1; background: linear-gradient(120deg, var(--a1), var(--a2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .metric span { color: var(--text-2); }

  /* Blocks */
  .block { display: grid; gap: 26px; margin-top: clamp(80px, 10vw, 130px); }
  .block-head { display: grid; gap: 14px; max-width: 860px; }
  .block-head h2 { font-size: clamp(32px, 4.6vw, 58px); text-wrap: balance; }
  .grad { background: linear-gradient(110deg, var(--a1), var(--a2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .note { color: var(--text-3); font-size: 14px; }
  .challenge blockquote { margin: 0; position: relative; padding-left: clamp(0px, 5vw, 70px); }
  .lead { font-family: var(--font-display); font-size: clamp(24px, 3.1vw, 40px); line-height: 1.28; letter-spacing: -0.025em; max-width: 1040px; text-wrap: pretty; }
  .q { position: absolute; left: 0; top: -0.25em; font-size: 2.6em; line-height: 1; background: linear-gradient(160deg, var(--a1), var(--a2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (max-width: 700px) { .q { position: static; display: block; height: 0.5em; } }

  .soon { display: grid; gap: 18px; justify-items: start; padding: clamp(26px, 4vw, 44px); border-style: dashed; }
  .soon p { font-family: var(--font-display); font-size: clamp(20px, 2.4vw, 28px); line-height: 1.35; letter-spacing: -0.02em; max-width: 820px; }

  .features { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .features li { --mx: 50%; --my: 50%; position: relative; overflow: hidden; display: grid; gap: 18px; align-content: start; padding: 26px 24px 30px; transition: transform 0.5s var(--ease), border-color 0.4s; }
  .features li::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, var(--a1), var(--a2)); opacity: 0.7; }
  .features li::after { content: ''; position: absolute; inset: 0; background: radial-gradient(320px circle at var(--mx) var(--my), color-mix(in srgb, var(--a1) 14%, transparent), transparent 60%); opacity: 0; transition: opacity 0.4s; pointer-events: none; }
  .features li:hover { transform: translateY(-4px); border-color: var(--line-2); }
  .features li:hover::after { opacity: 1; }
  .idx { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 12px; font-family: var(--font-mono); font-size: 13px; color: var(--a1); background: color-mix(in srgb, var(--a1) 12%, transparent); border: 1px solid color-mix(in srgb, var(--a1) 30%, transparent); }
  .features p { font-size: 16.5px; line-height: 1.55; }

  .gallery { display: grid; grid-template-columns: repeat(6, 1fr); gap: clamp(18px, 2.4vw, 32px); align-items: start; }
  .g-item { grid-column: span 3; }
  .g-item.tall { grid-column: span 2; }
  .g-item.tall :global(.shot) { max-width: 300px; margin: 0 auto; }

  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .stack li { padding: 10px 18px; border-radius: 99px; border: 1px solid var(--line-2); background: var(--surface); font-size: 15px; }

  /* CTA */
  .cta {
    position: relative; overflow: hidden; display: grid; grid-template-columns: 1.4fr auto; gap: 30px; align-items: end;
    padding: clamp(30px, 5vw, 64px); border-radius: 28px; border: 1px solid var(--line-2);
    background: radial-gradient(80% 120% at 100% 0%, color-mix(in srgb, var(--a1) 22%, transparent), transparent 60%),
                radial-gradient(60% 100% at 0% 100%, color-mix(in srgb, var(--a2) 16%, transparent), transparent 60%), var(--bg-2);
  }
  .cta-text { display: grid; gap: 14px; }
  .cta h2 { font-size: clamp(32px, 4.8vw, 62px); text-wrap: balance; }
  .cta p { color: var(--text-2); max-width: 560px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Previous / next */
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: clamp(60px, 8vw, 100px); padding-bottom: 40px; }
  .pn-card { display: grid; gap: 10px; padding: 14px 14px 22px; border-radius: var(--radius); border: 1px solid var(--line); background: linear-gradient(180deg, var(--surface-2), var(--surface)); transition: transform 0.5s var(--ease), border-color 0.4s; }
  .pn-card:hover { transform: translateY(-4px); border-color: var(--line-2); }
  .pn-media { height: 240px; overflow: hidden; border-radius: 14px; margin-bottom: 6px; pointer-events: none; }
  .pn-media :global(.cover) { min-height: 240px !important; height: 100%; }
  .pn-media :global(.shot) { transform: scale(1.02); transform-origin: top; }
  .pn-card .eyebrow { padding: 0 6px; }
  .pn-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(24px, 3vw, 36px); letter-spacing: -0.03em; padding: 0 6px; }
  .pn-title span { display: inline-block; transition: transform 0.4s var(--ease); }
  .pn-card:hover .pn-title span { transform: translateX(6px); }
  .pn-cat { color: var(--text-3); font-size: 14px; padding: 0 6px; }

  /* Lightbox */
  .lightbox { position: fixed; inset: 0; z-index: 85; display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; background: rgb(4 5 9 / 0.92); backdrop-filter: blur(10px); animation: lb-in 0.3s var(--ease); }
  .lightbox[hidden] { display: none; }
  @keyframes lb-in { from { opacity: 0; } }
  .lightbox figure { margin: 0; display: grid; gap: 14px; justify-items: center; max-height: 100vh; padding: 60px 0 30px; }
  .lightbox img { max-width: 100%; max-height: calc(100vh - 140px); width: auto; height: auto; border-radius: 12px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.6); }
  .lightbox figcaption { color: #cdd3e1; font-size: 15px; }
  .lb-close { position: absolute; top: 16px; right: 18px; width: 44px; height: 44px; border-radius: 50%; color: #fff; background: rgb(255 255 255 / 0.1); font-size: 18px; }
  .lb-nav { width: 48px; height: 48px; margin: 0 auto; border-radius: 50%; color: #fff; background: rgb(255 255 255 / 0.1); font-size: 28px; line-height: 1; }
  .lb-nav:hover, .lb-close:hover { background: rgb(255 255 255 / 0.2); }

  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr; align-items: start; }
    .features { grid-template-columns: 1fr 1fr; }
    .cta { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .features { grid-template-columns: 1fr; }
    .gallery { grid-template-columns: 1fr 1fr; }
    .g-item { grid-column: span 2; }
    .g-item.tall { grid-column: span 1; }
    .pn { grid-template-columns: 1fr; }
    .pn-media { height: 190px; }
    .lightbox { grid-template-columns: 44px 1fr 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .main-shot, .phone-shot { transform: none !important; opacity: 1 !important; transition: none; }
  }
</style>
