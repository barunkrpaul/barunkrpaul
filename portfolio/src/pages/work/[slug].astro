---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { projects, creditOf, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}
interface Props { project: Project; next: Project }
const { project: p, next } = Astro.props;
---
<Base title={p.title} description={p.summary}>
  <article class="case" style={`--a1:${p.accent[0]};--a2:${p.accent[1]}`}>
    <header class="wrap head">
      <a href="/#work" class="back" data-magnetic>← All work</a>
      <div class="meta reveal">
        {p.flagship && <span class="chip flag">★ Flagship</span>}
        <span class="chip">{p.category}</span>
        {p.year && <span class="chip">{p.year}</span>}
        <span class="chip status"><span class="dot-live"></span>{p.status}</span>
      </div>
      <h1 transition:name={`title-${p.slug}`}>{p.title}</h1>
      <p class="client reveal">Built for <b>{p.client}</b></p>
      <p class="summary reveal" style="--d:.1s">{p.summary}</p>
      {p.motto && <p class="motto reveal" style="--d:.15s">{p.motto}</p>}
      {p.links.length > 0 && (
        <div class="links reveal" style="--d:.2s">
          {p.links.map((l, i) => (
            <a href={l.href} target="_blank" rel="noopener" class:list={['btn', i === 0 ? 'btn-primary' : 'btn-ghost']} data-magnetic>
              {l.label} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="wrap reveal" style="--d:.25s">
      <Cover kind={p.cover} accent={p.accent} label={p.title} tag={p.category} large />
    </div>

    {p.pending && (
      <section class="wrap soon reveal">
        <div class="soon-inner glass">
          <span class="eyebrow">Walkthrough on request</span>
          <p>We are still writing up the full story behind {p.title}. Want to see it? We are happy to give you a live walkthrough.</p>
          <a href="/#contact" class="btn btn-ghost" data-magnetic>Ask for a walkthrough</a>
        </div>
      </section>
    )}

    {p.metrics.length > 0 && <section class="wrap metrics" aria-label="Key numbers">
      {p.metrics.map((m, i) => (
        <div class="metric reveal" style={`--d:${i * 0.08}s`}><b>{m.value}</b><span>{m.label}</span></div>
      ))}
    </section>}

    {p.problem && (
      <section class="wrap block">
        <span class="eyebrow reveal" data-scramble>The challenge</span>
        <p class="lead reveal">{p.problem}</p>
      </section>
    )}

    {p.highlights.length > 0 && (
      <section class="wrap block">
        <span class="eyebrow reveal" data-scramble>What we built</span>
        <ol class="highlights">
          {p.highlights.map((h, i) => (
            <li class="glass reveal" style={`--d:${(i % 2) * 0.08}s`} data-spot>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <p>{h}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {p.stack.length > 0 && (
      <section class="wrap block">
        <span class="eyebrow reveal" data-scramble>Built with</span>
        <ul class="stack reveal">{p.stack.map((s) => <li>{s}</li>)}</ul>
      </section>
    )}

    <section class="wrap block">
      <span class="eyebrow reveal" data-scramble>Who built it</span>
      <p class="lead reveal">{creditOf(p)}</p>
    </section>

    <a href={`/work/${next.slug}`} class="next wrap" data-hover>
      <span class="eyebrow">Next project</span>
      <span class="next-title">{next.title} <span aria-hidden="true">→</span></span>
    </a>
  </article>
</Base>

<style>
  .case { padding-top: 130px; }
  .head { display: grid; gap: 22px; margin-bottom: 48px; }
  .back { --mx: 0px; --my: 0px; justify-self: start; transform: translate(var(--mx), var(--my)); font-size: 14px; color: var(--text-2); padding: 8px 14px; border: 1px solid var(--line); border-radius: 99px; transition: color 0.2s, background 0.2s, transform 0.35s var(--ease); }
  .back:hover { color: var(--text); background: var(--surface-2); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip.flag { color: var(--amber); border-color: rgb(251 191 36 / 0.35); }
  .chip.status { color: #34d399; border-color: rgb(52 211 153 / 0.3); }
  h1 { font-size: clamp(54px, 10vw, 150px); letter-spacing: -0.055em; line-height: 0.92; background: linear-gradient(100deg, var(--text) 30%, var(--a1) 70%, var(--a2)); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: 0.06em; }
  .summary { font-size: clamp(18px, 2vw, 24px); color: var(--text-2); max-width: 820px; text-wrap: pretty; }
  .client { color: var(--text-3); font-size: 15px; margin-top: -6px; }
  .client b { color: var(--text); font-weight: 500; }
  .motto { font-family: var(--font-mono); font-size: 14px; color: var(--a1); }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }

  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-top: 56px; }
  .metric { border-top: 1px solid var(--line-2); padding-top: 20px; display: grid; gap: 4px; }
  .metric b { font-family: var(--font-display); font-weight: 600; font-size: clamp(44px, 5.6vw, 72px); letter-spacing: -0.05em; line-height: 1; background: linear-gradient(120deg, var(--a1), var(--a2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .metric span { color: var(--text-2); }

  .soon { margin-top: 56px; }
  .soon-inner { display: grid; gap: 18px; justify-items: start; padding: clamp(26px, 4vw, 44px); border-style: dashed; }
  .soon-inner p { font-family: var(--font-display); font-size: clamp(20px, 2.4vw, 28px); line-height: 1.35; letter-spacing: -0.02em; max-width: 820px; }
  .block { display: grid; gap: 24px; margin-top: clamp(80px, 10vw, 130px); }
  .lead { font-family: var(--font-display); font-size: clamp(24px, 3.2vw, 40px); line-height: 1.25; letter-spacing: -0.025em; max-width: 980px; text-wrap: pretty; }
  .highlights { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .highlights li { --mx: 50%; --my: 50%; position: relative; overflow: hidden; display: grid; grid-template-columns: auto 1fr; gap: 18px; padding: 26px; align-items: start; }
  .highlights li::after { content: ''; position: absolute; inset: 0; background: radial-gradient(300px circle at var(--mx) var(--my), color-mix(in srgb, var(--a1) 14%, transparent), transparent 60%); opacity: 0; transition: opacity 0.4s; pointer-events: none; }
  .highlights li:hover::after { opacity: 1; }
  .idx { font-family: var(--font-mono); font-size: 13px; color: var(--a1); padding-top: 3px; }
  .highlights p { font-size: 17px; }
  .stack { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .stack li { padding: 10px 18px; border-radius: 99px; border: 1px solid var(--line-2); background: var(--surface); font-size: 15px; }

  .next { display: grid; gap: 10px; margin-top: clamp(100px, 12vw, 160px); padding-top: 40px; padding-bottom: 40px; border-top: 1px solid var(--line); }
  .next-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(40px, 7vw, 100px); letter-spacing: -0.05em; line-height: 1; transition: letter-spacing 0.5s var(--ease); }
  .next-title span { display: inline-block; transition: transform 0.5s var(--ease); }
  .next:hover .next-title span { transform: translateX(16px); }
  .next:hover .next-title { letter-spacing: -0.04em; }

  @media (max-width: 760px) { .highlights { grid-template-columns: 1fr; } }
</style>
