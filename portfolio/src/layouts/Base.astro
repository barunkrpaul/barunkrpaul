---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import BrandSwitcher from '../components/BrandSwitcher.astro';
import { brands, tagline } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const brand = brands[0].name;
const {
  title,
  description = `Ujjal Kumar Das and Barun Kr Paul design and ship Android apps, web platforms, live scoring systems and NGO software. ${tagline.line1} ${tagline.line2}`,
} = Astro.props;
const fullTitle = title ? `${title} · ${brand}` : `${brand} · ${tagline.line1} ${tagline.line2}`;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-title-suffix={title ? `${title} · ` : ''}>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07080c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      // Apply the saved theme and name before the first paint, so nothing flashes.
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
          else d.setAttribute('data-theme', matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        } catch (e) { d.setAttribute('data-theme', 'dark'); }
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: brand,
        slogan: `${tagline.line1} ${tagline.line2}`,
        founder: [
          { '@type': 'Person', name: 'Ujjal Kumar Das', sameAs: ['https://github.com/ujjalmca'] },
          { '@type': 'Person', name: 'Barun Kr Paul', sameAs: ['https://github.com/barunkrpaul'] },
        ],
      })}
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <BrandSwitcher />
    <div class="cursor" aria-hidden="true" transition:persist="cursor"></div>
    <div class="cursor-dot" aria-hidden="true" transition:persist="cursor-dot"></div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
