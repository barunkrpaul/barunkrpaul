---
import Cover from './Cover.astro';
import { projects } from '../data/projects';
const [flagship, ...rest] = projects;
// Rows alternate 5+7 and 7+5 columns; the "your project next" card fills the gap.
const span = (i: number) => (Math.floor(i / 2) % 2 === 0 ? [5, 7] : [7, 5])[i % 2];
const nextSpan = rest.length % 2 === 0 ? 12 : 12 - span(rest.length - 1);
---
<section class="section work" id="work">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow" data-scramble>Selected work</span>
      <h2>Software people <span class="grad-text">rely on.</span></h2>
      <p>From a state championship scored live to an NGO working in remote villages: products we planned, built and delivered together.</p>
    </div>

    <div class="bento">
      <a href={`/work/${flagship.slug}`} class="card card-flag reveal" data-tilt data-hover>
        <div class="spot"></div>
        <div class="card-text">
          <div class="meta"><span class="chip flag">★ Flagship · {flagship.year}</span><span class="chip">{flagship.category}</span></div>
          <h3 transition:name={`title-${flagship.slug}`}>{flagship.title}</h3>
          <p>{flagship.summary}</p>
          <ul class="mini-metrics">
            {flagship.metrics.map((m) => <li><b>{m.value}</b><span>{m.label}</span></li>)}
          </ul>
          <span class="more">Read the case study <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
        <Cover kind={flagship.cover} accent={flagship.accent} large />
      </a>

      {rest.map((p, i) => (
        <a href={`/work/${p.slug}`} class:list={['card', 'reveal']} style={`--d:${(i % 2) * 0.08}s;--span:${span(i)}`} data-tilt data-hover>
          <div class="spot"></div>
          <Cover kind={p.cover} accent={p.accent} />
          <div class="card-text">
            <div class="meta"><span class="chip">{p.category}</span>{p.year && <span class="chip">{p.year}</span>}<span class="chip status">{p.status}</span></div>
            <h3 transition:name={`title-${p.slug}`}>{p.title}</h3>
            <p>{p.summary}</p>
            {p.stack.length > 0 && <div class="stack">{p.stack.slice(0, 4).map((s) => <span>{s}</span>)}</div>}
            <span class="more">{p.pending ? 'Case study coming soon' : 'Case study'} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
        </a>
      ))}

      <a href="#contact" class:list={['card', 'card-next', 'reveal', { wide: nextSpan === 12 }]} style={`--span:${nextSpan}`} data-tilt data-hover>
        <div class="spot"></div>
        <div class="next-inner">
          <span class="plus" aria-hidden="true">+</span>
          <h3>Your project <br /><span class="grad-text">could be next.</span></h3>
          <p>Tell us what you are building, and we will get back to you with ideas and a plan.</p>
          <span class="more">Start a project <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; }
  .card {
    --mx: 50%; --my: 50%; --rx: 0deg; --ry: 0deg;
    position: relative; display: flex; flex-direction: column; gap: 22px;
    padding: 14px 14px 26px; border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line);
    transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.5s var(--ease), border-color 0.4s, box-shadow 0.4s;
    overflow: hidden; isolation: isolate;
  }
  .card:hover { border-color: var(--line-2); box-shadow: var(--shadow); }
  .card::before {
    /* gradient border that lights up on hover */
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
    background: radial-gradient(400px circle at var(--mx) var(--my), rgb(var(--glow-cyan) / 0.7), rgb(var(--glow-violet) / 0.4) 40%, transparent 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: 0; transition: opacity 0.4s; pointer-events: none;
  }
  .card:hover::before { opacity: 1; }
  .spot { position: absolute; inset: 0; z-index: -1; background: radial-gradient(500px circle at var(--mx) var(--my), rgb(var(--glow-violet) / 0.1), transparent 60%); opacity: 0; transition: opacity 0.4s; }
  .card:hover .spot { opacity: 1; }

  .card-text { display: grid; gap: 14px; padding: 0 12px; align-content: start; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip.flag { color: var(--amber); border-color: rgb(251 191 36 / 0.35); }
  .chip.status { color: #34d399; border-color: rgb(52 211 153 / 0.3); }
  h3 { font-size: clamp(28px, 3.4vw, 42px); }
  .card-text p { color: var(--text-2); font-size: 15.5px; max-width: 560px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .stack span { font-size: 12px; color: var(--text-3); padding: 3px 9px; border-radius: 6px; background: var(--surface); }
  .more { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; margin-top: 4px; }
  .more svg { width: 16px; height: 16px; transition: transform 0.35s var(--ease); }
  .card:hover .more svg { transform: translateX(5px); }

  .card-flag { grid-column: span 12; display: grid; grid-template-columns: 1fr 1.15fr; align-items: center; padding: 14px; gap: 14px; }
  .card-flag .card-text { padding: 26px 20px; gap: 18px; }
  .card-flag h3 { font-size: clamp(40px, 5.6vw, 76px); }
  .mini-metrics { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, auto); gap: 18px; justify-content: start; }
  .mini-metrics li { display: grid; }
  .mini-metrics b { font-family: var(--font-display); font-size: 28px; line-height: 1; }
  .mini-metrics span { font-size: 12px; color: var(--text-3); }

  .card { grid-column: span var(--span, 12); }
  .card-next { justify-content: center; padding: 40px; border-style: dashed; }
  .card-next.wide { padding: 48px clamp(28px, 5vw, 64px); }
  .card-next.wide .next-inner { grid-template-columns: auto 1fr auto; align-items: center; gap: 6px 32px; }
  .card-next.wide .plus { grid-row: 1 / 3; }
  .card-next.wide h3 { grid-column: 2; }
  .card-next.wide p { grid-column: 2; }
  .card-next.wide .more { grid-column: 3; grid-row: 1 / 3; }
  .card-next.wide h3 br { display: none; }
  .next-inner { display: grid; gap: 16px; }
  .plus { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line-2); font-size: 28px; font-weight: 300; transition: transform 0.6s var(--ease), background 0.4s; }
  .card-next:hover .plus { transform: rotate(90deg); background: var(--surface-2); }
  .next-inner p { color: var(--text-2); }

  @media (max-width: 960px) {
    .card-flag { grid-template-columns: 1fr; }
    .card-flag .card-text { padding: 18px 12px 8px; }
    .card, .card-next { grid-column: span 12; }
    .card-next.wide .next-inner { grid-template-columns: 1fr; gap: 16px; }
    .card-next.wide .next-inner > * { grid-column: auto; grid-row: auto; }
    .mini-metrics { grid-template-columns: repeat(2, auto); }
  }
  @media (max-width: 560px) {
    .bento { gap: 14px; }
    .card-next { padding: 28px 22px; }
  }
</style>
