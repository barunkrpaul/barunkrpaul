---
// Illustrated covers for each project, drawn in HTML/CSS (no screenshots yet).
// They show the shape of each product, with sample values only.
interface Props { kind: 'pulse' | 'phone' | 'dashboard' | 'papers' | 'hotel' | 'transfer' | 'exam'; accent: [string, string]; large?: boolean }
const { kind, accent, large = false } = Astro.props;
---
<div class:list={['cover', `cover-${kind}`, { large }]} style={`--a1:${accent[0]};--a2:${accent[1]}`} aria-hidden="true">
  <div class="glow"></div>

  {kind === 'pulse' && (
    <div class="board">
      <div class="board-top">
        <span class="live"><span class="dot-live"></span>LIVE</span>
        <span class="mono">Giant display · Floor exercise</span>
        <span class="mono dim">Hall cam 1–8</span>
      </div>
      <svg class="ecg" viewBox="0 0 600 80" preserveAspectRatio="none">
        <path d="M0 40 H140 L160 40 L175 12 L192 70 L210 24 L224 40 H360 L378 40 L392 6 L410 74 L428 30 L440 40 H600" />
      </svg>
      <div class="rows">
        {[
          ['1', '14.350', '5.2', '9.150'],
          ['2', '13.975', '5.0', '8.975'],
          ['3', '13.600', '4.8', '8.800'],
          ['4', '13.125', '4.6', '8.525'],
        ].map(([rank, total, d, e], i) => (
          <div class="row" style={`--r:${i}`}>
            <span class="rank">{rank}</span>
            <span class="bar"></span>
            <span class="mono dim">D {d}</span>
            <span class="mono dim">E {e}</span>
            <span class="total">{total}</span>
          </div>
        ))}
      </div>
      <div class="tags">
        <span>MAG</span><span>WAG</span><span>Rhythmic</span><span>Acrobatic</span><span class="ok">✓ Chief Judge approved</span>
      </div>
    </div>
  )}

  {kind === 'phone' && (
    <div class="phone">
      <div class="notch"></div>
      <div class="screen">
        <div class="ph-top"><b>IPO One</b><span class="pill">Family · 4 PANs</span></div>
        <div class="stages">
          <span class="on">Open 3</span><span>Upcoming 5</span><span>Allotted</span>
        </div>
        {[0, 1, 2].map((i) => (
          <div class="ipo" style={`--r:${i}`}>
            <div class="ipo-l"><span class="logo"></span><span class="lines"><i></i><i></i></span></div>
            <div class="ipo-r"><span class="gmp">+{[42, 18, 65][i]}%</span><span class="mono dim">GMP</span></div>
          </div>
        ))}
        <div class="spark">
          <svg viewBox="0 0 200 50" preserveAspectRatio="none"><path d="M0 40 C30 38 40 20 70 26 S120 8 140 14 S180 4 200 6" /></svg>
        </div>
        <div class="lock"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg> AES-256 on device</div>
      </div>
    </div>
  )}

  {kind === 'dashboard' && (
    <div class="laptop">
      <div class="lap-screen">
        <aside><span></span><span class="on"></span><span></span><span></span><span></span></aside>
        <div class="lap-main">
          <div class="kpis">
            <div><b>15</b><span>Kendras</span></div>
            <div><b>4</b><span>User roles</span></div>
            <div><b>3</b><span>Districts</span></div>
          </div>
          <div class="chart">
            {[62, 80, 71, 90, 84, 95, 88].map((v, i) => <i style={`--h:${v}%;--r:${i}`}></i>)}
          </div>
          <div class="photos"><span></span><span></span><span></span><span class="sync">⟳ syncs when online</span></div>
        </div>
      </div>
      <div class="lap-base"></div>
    </div>
  )}

  {kind === 'hotel' && (
    <div class="keycard">
      <div class="kc-front">
        <span class="kc-chip"></span>
        <svg class="kc-wave" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 8a6 6 0 0 1 0 8M12 5a10 10 0 0 1 0 14M16 2a14 14 0 0 1 0 20" /></svg>
        <span class="kc-mono">D’A</span>
        <span class="kc-name">HOTEL D’AVANA</span>
        <span class="kc-line"></span>
      </div>
      <div class="kc-back"></div>
    </div>
  )}

  {kind === 'transfer' && (
    <div class="route">
      <svg viewBox="0 0 320 160" preserveAspectRatio="xMidYMid meet">
        <path id="route-path" class="rt-path" d="M40 120 C 100 10, 220 10, 280 120" />
        <circle class="rt-node" cx="40" cy="120" r="9" />
        <circle class="rt-node b" cx="280" cy="120" r="9" />
        <circle class="rt-dot" r="5"><animateMotion dur="3.2s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.45 0 0.2 1"><mpath href="#route-path" /></animateMotion></circle>
      </svg>
      <span class="rt-label a mono">From</span>
      <span class="rt-label b mono">To</span>
      <div class="rt-file"><span class="lines"><i></i><i></i></span><span class="rt-ok">✓</span></div>
    </div>
  )}

  {kind === 'exam' && (
    <div class="sched">
      <div class="sc-head"><b>Exam schedule</b><span class="mono dim">Week 1</span></div>
      <div class="sc-grid">
        {['', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'].map((d) => <span class="sc-day mono">{d}</span>)}
        {['AM', 'PM'].map((slot, r) => (
          <>
            <span class="sc-day mono">{slot}</span>
            {[0, 1, 2, 3, 4].map((c) => (
              <span class:list={['sc-cell', { on: (c + r) % 2 === 0, alt: c === 3 && r === 1 }]} style={`--r:${r * 5 + c}`}></span>
            ))}
          </>
        ))}
      </div>
      <div class="sc-foot"><span class="avatar"></span><span class="avatar"></span><span class="avatar"></span><span class="mono dim">Schedule published</span></div>
    </div>
  )}

  {kind === 'papers' && (
    <div class="papers">
      <div class="searchbar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span class="typed">Data Structures · 2024</span></div>
      <div class="filters"><span>University</span><span>College</span><span class="on">Subject</span></div>
      <div class="stack">
        {[0, 1, 2].map((i) => (
          <div class="sheet" style={`--r:${i}`}>
            <span class="pdf">PDF</span>
            <span class="lines"><i></i><i></i><i></i></span>
            {i === 0 && <span class="badge">✓ Reviewed</span>}
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .cover {
    position: relative; overflow: hidden; border-radius: 18px;
    min-height: 260px; display: grid; place-items: center; padding: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--a1) 22%, transparent), transparent 60%),
      radial-gradient(100% 80% at 0% 100%, color-mix(in srgb, var(--a2) 16%, transparent), transparent 60%),
      var(--bg-2);
    border: 1px solid var(--line);
  }
  .cover.large { min-height: 360px; }
  .glow { position: absolute; width: 60%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--a1) 35%, transparent), transparent 70%); filter: blur(30px); opacity: 0.6; animation: float 9s ease-in-out infinite alternate; }
  @keyframes float { to { transform: translate(14%, -10%); } }
  .mono { font-family: var(--font-mono); font-size: 11px; }
  .dim { color: var(--text-3); }

  /* ---- Gymlive board ---- */
  .board { position: relative; width: 100%; max-width: 560px; display: grid; gap: 14px; padding: 18px; border-radius: 16px; background: color-mix(in srgb, var(--bg) 80%, transparent); border: 1px solid var(--line-2); box-shadow: var(--shadow); }
  .board-top { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .board-top .dim { margin-left: auto; }
  .live { display: inline-flex; align-items: center; gap: 7px; padding: 3px 9px; border-radius: 6px; background: color-mix(in srgb, var(--a1) 22%, transparent); color: var(--a1); font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; }
  .live .dot-live { background: var(--a1); }
  .ecg { width: 100%; height: 46px; overflow: visible; }
  .ecg path { fill: none; stroke: var(--a1); stroke-width: 2; stroke-linejoin: round; stroke-dasharray: 900; stroke-dashoffset: 900; animation: ecg 3.2s linear infinite; filter: drop-shadow(0 0 6px var(--a1)); }
  @keyframes ecg { 60% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -900; } }
  .rows { display: grid; gap: 7px; }
  .row { display: grid; grid-template-columns: 22px 1fr auto auto 64px; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); animation: rowin 0.8s var(--ease) both; animation-delay: calc(var(--r) * 0.12s + 0.2s); }
  .row:first-child { border-color: color-mix(in srgb, var(--a2) 50%, transparent); background: color-mix(in srgb, var(--a2) 10%, transparent); }
  .rank { font-family: var(--font-display); font-weight: 700; color: var(--a2); }
  .bar { height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--line-2), transparent); }
  .total { font-family: var(--font-display); font-weight: 700; font-size: 18px; text-align: right; font-variant-numeric: tabular-nums; }
  @keyframes rowin { from { opacity: 0; transform: translateX(-12px); } }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span { font-family: var(--font-mono); font-size: 10.5px; padding: 3px 8px; border-radius: 6px; border: 1px solid var(--line); color: var(--text-2); }
  .tags .ok { color: #34d399; border-color: rgb(52 211 153 / 0.35); }

  /* ---- IPO phone ---- */
  .phone { position: relative; width: 210px; height: 400px; border-radius: 34px; padding: 10px; background: linear-gradient(160deg, #2a2f3d, #0d0f15); box-shadow: var(--shadow), inset 0 0 0 1px rgb(255 255 255 / 0.12); transform: rotate(-4deg); transition: transform 0.6s var(--ease); }
  :global(.card:hover) .phone { transform: rotate(0deg) translateY(-6px); }
  .notch { position: absolute; top: 16px; left: 50%; width: 60px; height: 16px; margin-left: -30px; border-radius: 10px; background: #000; z-index: 2; }
  .screen { height: 100%; border-radius: 26px; background: #0b1117; padding: 38px 12px 12px; display: grid; gap: 9px; align-content: start; color: #e6f6f3; overflow: hidden; }
  .ph-top { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-display); font-size: 15px; }
  .pill { font-family: var(--font-mono); font-size: 9px; padding: 3px 7px; border-radius: 99px; background: rgb(45 212 191 / 0.15); color: #5eead4; }
  .stages { display: flex; gap: 5px; }
  .stages span { white-space: nowrap; font-family: var(--font-mono); font-size: 9px; padding: 4px 7px; border-radius: 99px; background: rgb(255 255 255 / 0.06); color: #9fb3b0; }
  .stages .on { background: #2dd4bf; color: #04201c; font-weight: 600; }
  .ipo { display: flex; justify-content: space-between; align-items: center; padding: 9px; border-radius: 12px; background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.06); animation: rowin 0.8s var(--ease) both; animation-delay: calc(var(--r) * 0.12s + 0.2s); }
  .ipo-l { display: flex; gap: 8px; align-items: center; }
  .logo { width: 24px; height: 24px; border-radius: 7px; background: linear-gradient(135deg, var(--a1), var(--a2)); opacity: 0.85; }
  .lines { display: grid; gap: 4px; }
  .lines i { display: block; height: 5px; width: 64px; border-radius: 3px; background: rgb(255 255 255 / 0.18); }
  .lines i + i { width: 40px; background: rgb(255 255 255 / 0.09); }
  .ipo-r { display: grid; justify-items: end; }
  .gmp { font-family: var(--font-display); font-weight: 700; color: #34d399; font-size: 14px; }
  .spark { height: 50px; border-radius: 12px; background: rgb(255 255 255 / 0.04); padding: 6px; }
  .spark svg { width: 100%; height: 100%; }
  .spark path { fill: none; stroke: #2dd4bf; stroke-width: 2; stroke-dasharray: 300; stroke-dashoffset: 300; animation: draw 2.4s var(--ease) 0.4s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .lock { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 9.5px; color: #9fb3b0; }
  .lock svg { width: 12px; height: 12px; color: #5eead4; }

  /* ---- AVK laptop ---- */
  .laptop { width: min(440px, 100%); transform: perspective(1000px) rotateX(8deg); transition: transform 0.6s var(--ease); }
  :global(.card:hover) .laptop { transform: perspective(1000px) rotateX(0deg) translateY(-4px); }
  .lap-screen { aspect-ratio: 16 / 10; border-radius: 14px 14px 4px 4px; border: 8px solid #1d2129; background: #faf8f2; display: grid; grid-template-columns: 38px 1fr; overflow: hidden; box-shadow: var(--shadow); }
  .lap-base { height: 12px; margin: 0 -6%; border-radius: 0 0 14px 14px; background: linear-gradient(#2a2f3a, #14171d); }
  aside { background: #17392d; display: grid; gap: 8px; align-content: start; padding: 10px 9px; }
  aside span { height: 18px; border-radius: 6px; background: rgb(255 255 255 / 0.12); }
  aside .on { background: #d9b66f; }
  .lap-main { padding: 12px; display: grid; gap: 10px; align-content: start; color: #17392d; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .kpis div { padding: 8px; border-radius: 9px; background: #e5f0e6; display: grid; }
  .kpis b { font-family: var(--font-display); font-size: 18px; line-height: 1.1; }
  .kpis span { font-size: 9px; color: #4b6b5d; }
  .chart { height: 74px; display: flex; align-items: flex-end; gap: 6px; padding: 8px; border-radius: 9px; background: #fff; border: 1px solid #e3e0d6; }
  .chart i { flex: 1; height: var(--h); border-radius: 4px 4px 2px 2px; background: linear-gradient(#244c3b, #a8bea5); transform-origin: bottom; animation: grow 1s var(--ease) both; animation-delay: calc(var(--r) * 0.08s + 0.2s); }
  .chart i:nth-child(6) { background: linear-gradient(#c77752, #d9b66f); }
  @keyframes grow { from { transform: scaleY(0); } }
  .photos { display: flex; gap: 6px; align-items: center; }
  .photos span:not(.sync) { width: 40px; height: 28px; border-radius: 6px; background: linear-gradient(135deg, #a8bea5, #d9b66f); }
  .sync { margin-left: auto; font-family: var(--font-mono); font-size: 9px; color: #c77752; }

  /* ---- Question papers ---- */
  .papers { width: min(380px, 100%); display: grid; gap: 12px; }
  .searchbar { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 12px; background: color-mix(in srgb, var(--bg) 80%, transparent); border: 1px solid var(--line-2); font-size: 14px; }
  .searchbar svg { width: 16px; height: 16px; color: var(--a1); flex: none; }
  .typed { overflow: hidden; white-space: nowrap; border-right: 2px solid var(--a1); width: 0; animation: type 2.6s steps(22) 0.5s forwards, caret 0.8s step-end infinite; }
  @keyframes type { to { width: 22ch; } }
  @keyframes caret { 50% { border-color: transparent; } }
  .filters { display: flex; gap: 6px; }
  .filters span { font-family: var(--font-mono); font-size: 11px; padding: 4px 10px; border-radius: 99px; border: 1px solid var(--line); color: var(--text-2); }
  .filters .on { border-color: var(--a1); color: var(--a1); }
  .stack { position: relative; height: 150px; }
  .sheet { position: absolute; inset: 0; display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 14px; background: color-mix(in srgb, var(--bg-2) 70%, #fff 6%); border: 1px solid var(--line-2); transform: translateY(calc(var(--r) * 18px)) scale(calc(1 - var(--r) * 0.05)); z-index: calc(3 - var(--r)); opacity: calc(1 - var(--r) * 0.3); transition: transform 0.6s var(--ease); height: 96px; box-shadow: var(--shadow); }
  :global(.card:hover) .sheet { transform: translateY(calc(var(--r) * 30px)) scale(calc(1 - var(--r) * 0.04)); }
  .pdf { width: 42px; height: 52px; display: grid; place-items: center; border-radius: 8px; background: linear-gradient(135deg, var(--a1), var(--a2)); color: #fff; font-family: var(--font-mono); font-size: 10px; font-weight: 600; }
  .sheet .lines i { width: 140px; background: var(--line-2); }
  .sheet .lines i + i { width: 100px; background: var(--line); }
  .badge { margin-left: auto; font-family: var(--font-mono); font-size: 10px; color: #34d399; padding: 3px 8px; border-radius: 99px; border: 1px solid rgb(52 211 153 / 0.35); white-space: nowrap; }

  /* ---- Hotel key card ---- */
  .keycard { position: relative; width: min(300px, 80%); aspect-ratio: 1.586; }
  .kc-front, .kc-back { position: absolute; inset: 0; border-radius: 16px; }
  .kc-back { background: linear-gradient(135deg, #2a2233, #14111a); transform: translate(18px, 16px) rotate(6deg); border: 1px solid rgb(255 255 255 / 0.08); }
  .kc-front {
    z-index: 1; padding: 18px; display: grid; grid-template-rows: auto 1fr auto auto; color: #f5e6c8;
    background: radial-gradient(120% 120% at 0% 0%, #3a2c1e, #15110d 70%);
    border: 1px solid color-mix(in srgb, var(--a1) 55%, transparent);
    box-shadow: var(--shadow), inset 0 0 40px rgb(224 184 114 / 0.08);
    transform: rotate(-5deg); transition: transform 0.6s var(--ease);
    overflow: hidden;
  }
  .kc-front::after { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 35%, rgb(255 240 210 / 0.18) 50%, transparent 65%); transform: translateX(-100%); animation: sheen 4.5s ease-in-out infinite; }
  @keyframes sheen { 55%, 100% { transform: translateX(100%); } }
  :global(.card:hover) .kc-front { transform: rotate(0deg) translateY(-6px); }
  .kc-chip { width: 34px; height: 26px; border-radius: 6px; background: linear-gradient(135deg, #f3d9a4, #b8893f); }
  .kc-wave { position: absolute; right: 16px; top: 16px; width: 22px; height: 22px; color: var(--a1); opacity: 0.8; }
  .kc-mono { align-self: center; justify-self: center; font-family: var(--font-display); font-size: 46px; font-weight: 500; letter-spacing: 0.02em; background: linear-gradient(180deg, #fbe8c2, var(--a1)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .kc-name { justify-self: center; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.32em; color: #d9c29a; }
  .kc-line { height: 1px; margin-top: 10px; background: linear-gradient(90deg, transparent, var(--a1), transparent); }

  /* ---- Transfer route ---- */
  .route { position: relative; width: min(380px, 100%); }
  .route svg { width: 100%; overflow: visible; }
  .rt-path { fill: none; stroke: color-mix(in srgb, var(--a1) 60%, transparent); stroke-width: 2; stroke-dasharray: 4 7; animation: dash 1.2s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -22; } }
  .rt-node { fill: var(--bg); stroke: var(--a1); stroke-width: 3; }
  .rt-node.b { stroke: var(--a2); }
  .rt-dot { fill: var(--a2); filter: drop-shadow(0 0 8px var(--a2)); }
  .rt-label { position: absolute; top: 82%; color: var(--text-2); }
  .rt-label.a { left: 6%; }
  .rt-label.b { right: 8%; }
  .rt-file { position: absolute; left: 50%; top: 52%; translate: -50% -50%; display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 12px; background: color-mix(in srgb, var(--bg) 85%, transparent); border: 1px solid var(--line-2); box-shadow: var(--shadow); }
  .rt-file .lines i { width: 90px; background: var(--line-2); }
  .rt-file .lines i + i { width: 60px; background: var(--line); }
  .rt-ok { width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; font-size: 12px; color: #04201c; background: #34d399; }

  /* ---- Exam schedule ---- */
  .sched { width: min(400px, 100%); padding: 16px; border-radius: 16px; display: grid; gap: 12px; background: color-mix(in srgb, var(--bg) 82%, transparent); border: 1px solid var(--line-2); box-shadow: var(--shadow); }
  .sc-head { display: flex; justify-content: space-between; align-items: baseline; font-family: var(--font-display); }
  .sc-grid { display: grid; grid-template-columns: 34px repeat(5, 1fr); gap: 6px; align-items: center; }
  .sc-day { text-align: center; color: var(--text-3); font-size: 10px; }
  .sc-cell { height: 38px; border-radius: 8px; background: var(--surface-2); border: 1px solid var(--line); }
  .sc-cell.on { background: linear-gradient(135deg, color-mix(in srgb, var(--a1) 75%, transparent), color-mix(in srgb, var(--a2) 55%, transparent)); border-color: transparent; animation: pop-in 0.6s var(--ease) both; animation-delay: calc(var(--r) * 0.07s + 0.2s); }
  .sc-cell.alt { background: transparent; border: 1.5px dashed var(--a1); }
  @keyframes pop-in { from { opacity: 0; transform: scale(0.6); } }
  .sc-foot { display: flex; align-items: center; gap: 4px; }
  .avatar { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--bg-2); background: linear-gradient(135deg, var(--a1), var(--a2)); margin-right: -8px; }
  .sc-foot .mono { margin-left: 16px; }

  @media (max-width: 560px) {
    .cover { padding: 18px; min-height: 230px; }
    .cover.large { min-height: 300px; }
    .row { grid-template-columns: 18px 1fr auto 56px; }
    .row span:nth-of-type(4) { display: none; }
    .board-top .dim { display: none; }
    .sheet .lines i { width: 90px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover *, .glow { animation: none !important; }
    .typed { width: 22ch; }
    .ecg path, .spark path { stroke-dashoffset: 0; }
  }
</style>
