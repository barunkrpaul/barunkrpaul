---
import Logo from './Logo.astro';
import { brands } from '../data/site';
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#duo', label: 'The Duo' },
  { href: '/#services', label: 'Services' },
  { href: '/#process', label: 'Process' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="nav" data-nav transition:persist="nav">
  <div class="nav-inner glass">
    <a href="/" class="brand" aria-label="Home">
      <Logo />
      <span class="brand-name" data-brand-name>{brands[0].name}</span>
    </a>
    <nav class="links" aria-label="Main">
      {links.map((l) => <a href={l.href} data-magnetic>{l.label}</a>)}
    </nav>
    <div class="actions">
      <button class="icon-btn palette-btn" data-open-palette aria-label="Open command menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 17l6-5-6-5M12 19h8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <kbd class="kbd-hint">⌘K</kbd>
      </button>
      <button class="icon-btn" data-theme-toggle aria-label="Switch light or dark theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" stroke-linejoin="round"/></svg>
      </button>
      <a href="/#contact" class="btn btn-primary nav-cta" data-magnetic>Start a project</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed; top: 14px; left: 0; right: 0; z-index: 50;
    padding: 0 var(--gutter);
    transition: transform 0.5s var(--ease);
  }
  .nav.hide { transform: translateY(-120%); }
  .nav-inner {
    max-width: var(--max); margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 62px; padding: 0 10px 0 18px; border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 62%, transparent);
  }
  .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 600; font-size: 18px; letter-spacing: -0.02em; white-space: nowrap; }
  .links { display: flex; gap: 4px; }
  .links a {
    --mx: 0px; --my: 0px;
    padding: 8px 14px; border-radius: 999px; font-size: 14px; color: var(--text-2);
    transform: translate(var(--mx), var(--my));
    transition: color 0.25s, background 0.25s, transform 0.35s var(--ease);
  }
  .links a:hover { color: var(--text); background: var(--surface-2); }
  .actions { display: flex; align-items: center; gap: 6px; }
  .icon-btn {
    height: 42px; min-width: 42px; padding: 0 10px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    color: var(--text-2); transition: background 0.25s, color 0.25s;
  }
  .icon-btn:hover { background: var(--surface-2); color: var(--text); }
  .icon-btn svg { width: 19px; height: 19px; }
  :global(:root[data-theme='light']) .sun { display: none; }
  :global(:root:not([data-theme='light'])) .moon { display: none; }
  .nav-cta { height: 42px; padding: 0 18px; font-size: 14px; }
  @media (max-width: 960px) {
    .links { display: none; }
  }
  @media (max-width: 560px) {
    .nav-cta, .kbd-hint { display: none; }
    .nav-inner { padding-left: 14px; }
    .brand { font-size: 16px; }
  }
</style>
