---
import Logo from './Logo.astro';
import { brands, tagline, people, contactEmail } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="big" aria-hidden="true">
      <span>{tagline.line1}</span>
      <span class="grad-text">{tagline.line2}</span>
    </div>
    <div class="row">
      <a href="/" class="brand"><Logo size={26} /><span data-brand-name>{brands[0].name}</span></a>
      <div class="cols">
        {people.map((p) => (
          <div>
            <p class="who">{p.name}</p>
            <ul>{p.links.map((l) => <li><a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a></li>)}</ul>
          </div>
        ))}
        <div>
          <p class="who">Say hello</p>
          <ul><li><a href={`mailto:${contactEmail}`}>{contactEmail}</a></li><li><button data-open-palette>Command menu <kbd>⌘K</kbd></button></li></ul>
        </div>
      </div>
    </div>
    <p class="legal">© {year} Ujjal Kumar Das & Barun Kr Paul · Designed and built by us, in West Bengal, India.</p>
  </div>
</footer>

<style>
  .footer { padding: 120px 0 40px; border-top: 1px solid var(--line); overflow: hidden; }
  .big {
    display: flex; flex-wrap: wrap; gap: 0 0.3em;
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.05em; line-height: 0.95;
    font-size: clamp(52px, 11vw, 168px); margin-bottom: 80px;
  }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 40px; }
  .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 600; font-size: 20px; }
  .cols { display: flex; flex-wrap: wrap; gap: 48px; }
  .who { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  ul a, ul button { color: var(--text-2); font-size: 15px; transition: color 0.2s; display: inline-flex; gap: 8px; align-items: center; }
  ul a:hover, ul button:hover { color: var(--text); }
  .legal { margin-top: 64px; color: var(--text-3); font-size: 13px; }
</style>
