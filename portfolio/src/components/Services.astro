---
import { services, process } from '../data/site';
const icons: Record<string, string> = {
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/>',
  leaf: '<path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19c3-4 6-6 10-8"/>',
  pulse: '<path d="M2 12h4l2-6 4 12 3-9 2 3h5"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/>',
};
---
<section class="section services" id="services">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow" data-scramble>What we do</span>
      <h2>Built for the way <span class="grad-text">you work.</span></h2>
      <p>We take projects from idea to launch, and stay to support them after. These are the things we are best at.</p>
    </div>
    <div class="grid">
      {services.map((s, i) => (
        <article class="svc glass reveal" style={`--d:${(i % 3) * 0.08}s`} data-hover data-spot>
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} /></span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <span class="num">0{i + 1}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section process" id="process">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow" data-scramble>How we work</span>
      <h2>Clear steps. <span class="grad-text">No surprises.</span></h2>
    </div>
    <ol class="steps" data-progress>
      <span class="rail" aria-hidden="true"><span class="fill"></span></span>
      {process.map((p, i) => (
        <li class="reveal" style={`--d:${i * 0.1}s`}>
          <span class="node" aria-hidden="true"></span>
          <span class="mono">{p.step}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .svc {
    --mx: 50%; --my: 50%;
    position: relative; overflow: hidden; padding: 30px 26px 34px; display: grid; gap: 14px; align-content: start;
    transition: border-color 0.4s, transform 0.5s var(--ease);
  }
  .svc::after { content: ''; position: absolute; inset: 0; background: radial-gradient(360px circle at var(--mx) var(--my), rgb(var(--glow-cyan) / 0.12), transparent 60%); opacity: 0; transition: opacity 0.4s; pointer-events: none; }
  .svc:hover { border-color: var(--line-2); transform: translateY(-4px); }
  .svc:hover::after { opacity: 1; }
  .ico { width: 50px; height: 50px; display: grid; place-items: center; border-radius: 14px; background: linear-gradient(135deg, rgb(var(--glow-cyan) / 0.18), rgb(var(--glow-violet) / 0.18)); border: 1px solid var(--line-2); color: var(--cyan); }
  .ico svg { width: 24px; height: 24px; }
  .svc h3 { font-size: 23px; letter-spacing: -0.02em; }
  .svc p { color: var(--text-2); font-size: 15px; }
  .num { position: absolute; right: 22px; top: 22px; font-family: var(--font-mono); font-size: 12px; color: var(--text-3); }

  .steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .rail { position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: var(--line-2); }
  .fill { position: absolute; inset: 0; background: var(--grad); transform-origin: left; transform: scaleX(var(--p, 0)); box-shadow: 0 0 12px rgb(var(--glow-violet) / 0.7); }
  .steps li { position: relative; display: grid; gap: 10px; padding-top: 36px; }
  .node { position: absolute; top: 0; left: 0; width: 15px; height: 15px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--text-2); }
  .steps li.in .node { border-color: var(--cyan); box-shadow: 0 0 0 5px rgb(var(--glow-cyan) / 0.15); }
  .steps .mono { font-family: var(--font-mono); font-size: 12px; color: var(--text-3); }
  .steps h3 { font-size: 26px; }
  .steps p { color: var(--text-2); font-size: 15px; }

  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 30px; padding-left: 34px; }
    .rail { left: 7px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .fill { transform-origin: top; transform: scaleY(var(--p, 0)); }
    .steps li { padding-top: 0; }
    .node { left: -34px; top: 4px; }
  }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
