---
import { tagline, intro, availability, people } from '../data/site';
const split = (s: string, offset = 0) =>
  [...s].map((ch, i) => ({ ch: ch === ' ' ? ' ' : ch, i: i + offset }));
const l1 = split(tagline.line1);
const l2 = split(tagline.line2, l1.length + 2);
---
<section class="hero" data-hero>
  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
  <canvas class="field" data-hero-canvas aria-hidden="true"></canvas>
  <div class="centroid-label" data-centroid-label="0" aria-hidden="true"><img src={people[0].face} alt="" width="26" height="26" />{people[0].first}</div>
  <div class="centroid-label" data-centroid-label="1" aria-hidden="true"><img src={people[1].face} alt="" width="26" height="26" />{people[1].first}</div>

  <div class="wrap inner">
    <div class="chip status reveal"><span class="dot-live"></span>{availability} · Nadia, West Bengal</div>
    <h1 aria-label={`${tagline.line1} ${tagline.line2}`}>
      <span class="line" aria-hidden="true">{l1.map((c) => <span class="ch" style={`--i:${c.i}`}>{c.ch}</span>)}</span>
      <span class="line grad-line" aria-hidden="true">{l2.map((c) => <span class="ch" style={`--i:${c.i}`}>{c.ch}</span>)}</span>
    </h1>
    <p class="lede reveal" style="--d:.7s">{intro}</p>
    <div class="ctas reveal" style="--d:.85s">
      <a href="#work" class="btn btn-primary" data-magnetic>
        See our work
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost" data-magnetic>Start a project</a>
    </div>
    <p class="hint reveal" style="--d:1s">Move your cursor through the field · click to send a pulse · press <kbd>/</kbd> for the command menu</p>
  </div>

  <a href="#work" class="scroll-cue" aria-label="Scroll to our work"><span></span></a>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: center;
    overflow: hidden; padding: 120px 0 90px;
  }
  .field { position: absolute; inset: 0; width: 100%; height: 100%; }
  .aurora { position: absolute; inset: 0; pointer-events: none; filter: blur(70px); opacity: 0.55; }
  .aurora span { position: absolute; border-radius: 50%; animation: drift 22s ease-in-out infinite alternate; }
  .aurora span:nth-child(1) { width: 48vw; height: 48vw; left: 48%; top: -10%; background: radial-gradient(circle, rgb(var(--glow-violet) / 0.45), transparent 65%); }
  .aurora span:nth-child(2) { width: 40vw; height: 40vw; left: 62%; top: 35%; background: radial-gradient(circle, rgb(var(--glow-cyan) / 0.32), transparent 65%); animation-delay: -6s; }
  .aurora span:nth-child(3) { width: 34vw; height: 34vw; left: -8%; top: 55%; background: radial-gradient(circle, rgb(244 114 182 / 0.18), transparent 65%); animation-delay: -12s; }
  @keyframes drift { to { transform: translate(-6vw, 4vw) scale(1.12); } }

  .inner { position: relative; z-index: 2; pointer-events: none; }
  .inner :global(a), .inner :global(button) { pointer-events: auto; }
  .status { margin-bottom: 28px; background: color-mix(in srgb, var(--bg) 60%, transparent); backdrop-filter: blur(8px); }

  h1 {
    font-size: clamp(56px, 11.5vw, 176px); line-height: 0.9; letter-spacing: -0.055em; font-weight: 600;
    display: grid; margin-bottom: 30px;
  }
  .line { display: block; white-space: nowrap; }
  .ch {
    display: inline-block; opacity: 0; transform: translateY(0.5em) rotate(6deg); filter: blur(10px);
    animation: ch-in 1.1s var(--ease) forwards; animation-delay: calc(var(--i) * 0.035s + 0.15s);
  }
  .grad-line .ch {
    background: var(--grad); background-size: 900% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    background-position: calc(var(--i) * 6%) 0;
  }
  @keyframes ch-in { to { opacity: 1; transform: none; filter: none; } }

  .lede { max-width: 560px; font-size: clamp(17px, 1.7vw, 20px); color: var(--text-2); margin-bottom: 36px; text-wrap: pretty; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hint { margin-top: 40px; font-size: 13px; color: var(--text-3); }

  .centroid-label {
    position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none;
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text); opacity: 0; transition: opacity 0.8s;
    padding: 5px 10px 5px 8px; border-radius: 999px; border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--bg) 55%, transparent); backdrop-filter: blur(6px);
    will-change: transform;
  }
  .centroid-label { padding-left: 4px; }
  .centroid-label img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--cyan); box-shadow: 0 0 14px rgb(var(--glow-cyan) / 0.6); }
  .centroid-label[data-centroid-label='1'] img { border-color: #a78bfa; box-shadow: 0 0 14px rgb(167 139 250 / 0.6); }
  .centroid-label.on { opacity: 1; }

  .scroll-cue {
    position: absolute; left: 50%; bottom: 26px; z-index: 2; width: 26px; height: 42px; margin-left: -13px;
    border: 1.5px solid var(--line-2); border-radius: 20px;
  }
  .scroll-cue span { position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: var(--text-2); animation: cue 1.8s var(--ease) infinite; }
  @keyframes cue { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }

  @media (max-width: 800px) {
    .hero { align-items: flex-end; padding-bottom: 110px; }
    .hint { display: none; }
    .centroid-label { font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch { animation: none; opacity: 1; transform: none; filter: none; }
    .aurora span, .scroll-cue span { animation: none; }
  }
</style>
