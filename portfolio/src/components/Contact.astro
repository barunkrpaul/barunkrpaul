---
import { people, contactEmail } from '../data/site';
const types = ['Android app', 'Web platform', 'Live event / scoring system', 'NGO or education system', 'Dashboard or internal tool', 'Something else'];
const budgets = ['Under ₹1 lakh', '₹1–3 lakh', '₹3–10 lakh', '₹10 lakh +', 'Not sure yet'];
const timelines = ['As soon as possible', '1–3 months', '3–6 months', 'Flexible'];
const direct = [
  { label: 'Email', value: contactEmail, href: `mailto:${contactEmail}` },
  ...people.flatMap((p) => p.links.filter((l) => l.label !== 'Email').map((l) => ({ label: `${p.first} · ${l.label}`, value: l.href.replace(/^https?:\/\/(www\.)?/, ''), href: l.href }))),
];
---
<section class="section contact" id="contact">
  <div class="wrap layout">
    <div class="intro reveal">
      <span class="eyebrow" data-scramble>Start a project</span>
      <h2>Let’s build <span class="grad-text">something great.</span></h2>
      <p>Answer three quick questions and add a few lines about your idea. Your email app opens with everything filled in, ready to send to us.</p>
      <ul class="direct">
        {direct.map((d) => (
          <li><a href={d.href} target={d.href.startsWith('http') ? '_blank' : undefined} rel="noopener" data-hover><span>{d.label}</span><b>{d.value}</b><i aria-hidden="true">↗</i></a></li>
        ))}
      </ul>
    </div>

    <form class="brief glass reveal" data-brief data-to={contactEmail} novalidate>
      <fieldset>
        <legend><span class="n">1</span> What are you building?</legend>
        <div class="opts">{types.map((t, i) => <label><input type="radio" name="type" value={t} required={i === 0} /><span>{t}</span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend><span class="n">2</span> Rough budget</legend>
        <div class="opts">{budgets.map((t) => <label><input type="radio" name="budget" value={t} /><span>{t}</span></label>)}</div>
      </fieldset>
      <fieldset>
        <legend><span class="n">3</span> Timeline</legend>
        <div class="opts">{timelines.map((t) => <label><input type="radio" name="timeline" value={t} /><span>{t}</span></label>)}</div>
      </fieldset>
      <div class="fields">
        <label class="field"><span>Your name</span><input name="name" type="text" autocomplete="name" required /></label>
        <label class="field"><span>Organisation (optional)</span><input name="org" type="text" autocomplete="organization" /></label>
        <label class="field full"><span>Tell us about it</span><textarea name="details" rows="4" placeholder="Who will use it, what it should do, anything you already have…"></textarea></label>
      </div>
      <div class="submit">
        <button type="submit" class="btn btn-primary" data-magnetic>
          Send the brief
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="status" data-brief-status role="status"></p>
      </div>
    </form>
  </div>
</section>

<style>
  .layout { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 56px; align-items: start; }
  .intro { display: grid; gap: 18px; position: sticky; top: 110px; }
  .intro h2 { font-size: clamp(40px, 6vw, 76px); }
  .intro > p { color: var(--text-2); font-size: 17px; max-width: 460px; }
  .direct { list-style: none; margin: 18px 0 0; padding: 0; display: grid; border-top: 1px solid var(--line); }
  .direct a { display: grid; grid-template-columns: 130px 1fr auto; gap: 12px; align-items: center; padding: 15px 4px; border-bottom: 1px solid var(--line); transition: padding 0.35s var(--ease), background 0.3s; }
  .direct a:hover { padding-left: 14px; background: var(--surface); }
  .direct span { font-family: var(--font-mono); font-size: 12px; color: var(--text-3); }
  .direct b { font-weight: 500; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .direct i { font-style: normal; color: var(--text-3); }

  .brief { padding: clamp(22px, 3.5vw, 40px); display: grid; gap: 28px; }
  fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 14px; }
  legend { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 600; font-size: 20px; padding: 0; margin-bottom: 14px; }
  .n { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; font-family: var(--font-mono); font-size: 12px; background: var(--surface-2); border: 1px solid var(--line-2); }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opts label { position: relative; cursor: pointer; }
  .opts input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .opts span { display: inline-block; padding: 10px 16px; border-radius: 99px; border: 1px solid var(--line-2); font-size: 14px; color: var(--text-2); transition: all 0.25s var(--ease); }
  .opts label:hover span { color: var(--text); border-color: var(--text-3); }
  .opts input:checked + span { color: var(--bg); background: var(--text); border-color: var(--text); box-shadow: 0 0 0 4px rgb(var(--glow-cyan) / 0.18); }
  .opts input:focus-visible + span { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .field { display: grid; gap: 8px; }
  .field.full { grid-column: 1 / -1; }
  .field span { font-size: 13px; color: var(--text-2); }
  .field input, .field textarea {
    width: 100%; font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--line-2);
    border-radius: 12px; padding: 13px 14px; outline: none; transition: border-color 0.25s, box-shadow 0.25s; resize: vertical;
  }
  .field input:focus, .field textarea:focus { border-color: var(--cyan); box-shadow: 0 0 0 4px rgb(var(--glow-cyan) / 0.14); }
  .field ::placeholder { color: var(--text-3); }
  .submit { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .status { color: var(--text-2); font-size: 14px; }
  .status.err { color: var(--magenta); }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; gap: 40px; }
    .intro { position: static; }
  }
  @media (max-width: 560px) {
    .fields { grid-template-columns: 1fr; }
    .direct a { grid-template-columns: 1fr auto; }
    .direct span { grid-column: 1 / -1; }
  }
</style>
